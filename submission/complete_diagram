VERDICT["Final Verdict"]

LEARN["Continuous Learning"]

START --> COLLECT

COLLECT --> DOC

DOC --> GRAPH

GRAPH --> ORCH

ORCH --> CUSTOMER

ORCH --> MERCHANT

ORCH --> POLICY

ORCH --> CASEAI

